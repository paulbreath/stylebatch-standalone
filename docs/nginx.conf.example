# StyleBatch Nginx 配置文件
# 将此文件复制到 /etc/nginx/sites-available/stylebatch

server {
    listen 80;
    server_name YOUR_DOMAIN_OR_IP;  # 替换为您的域名或服务器 IP

    # 允许上传大文件（最大 50MB）
    client_max_body_size 50M;

    # 反向代理到 Node.js 应用
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        
        # WebSocket 支持
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        
        # 请求头设置
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 缓存控制
        proxy_cache_bypass $http_upgrade;
        
        # 超时设置（AI 转换可能需要较长时间）
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;

    # 访问日志
    access_log /var/log/nginx/stylebatch_access.log;
    error_log /var/log/nginx/stylebatch_error.log;
}

# SSL 配置（Let's Encrypt 自动生成）
# 运行以下命令自动配置 SSL：
# sudo certbot --nginx -d YOUR_DOMAIN
